#!/bin/bash
# Start Dolt's MySQL-protocol server the way dblib/dolt_mysql.py expects it:
# 127.0.0.1:3306, user root with no password, data in ~/dolt/databases.
set -euo pipefail

runs="$(cd "$(dirname "$0")/.." && pwd)/.runs"
data_dir="${DOLT_MYSQL_DATA_DIR:-$HOME/dolt/databases}"
mkdir -p "$runs" "$data_dir"

if [ -f "$runs/dolt_mysql.pid" ] && kill -0 "$(cat "$runs/dolt_mysql.pid")" 2>/dev/null; then
    echo "Dolt already running (pid $(cat "$runs/dolt_mysql.pid"))"
    exit 0
fi

cd "$data_dir"
dolt sql-server --data-dir "$data_dir" \
    --host "${DOLT_MYSQL_HOST:-127.0.0.1}" --port "${DOLT_MYSQL_PORT:-3306}" \
    > "$runs/dolt_mysql.log" 2>&1 &
echo $! > "$runs/dolt_mysql.pid"
